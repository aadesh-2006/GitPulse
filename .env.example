# ==============================================================================
# GitPulse Environment Configuration Template
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Server Configuration
SERVER_PORT=8080

# PostgreSQL Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=gitpulse
DB_USERNAME=gitpulse
DB_PASSWORD=gitpulse

# Redis Configuration (Best-effort evolution cache)
REDIS_HOST=localhost
REDIS_PORT=6379
EVOLUTION_CACHE_TTL=5m

# Apache Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_PORT=9092
KAFKA_ADVERTISED_HOST=localhost
KAFKA_PRODUCER_MAX_BLOCK_MS=5000
KAFKA_TOPIC_ANALYSIS_JOBS=analysis-jobs
KAFKA_TOPIC_ANALYSIS_JOBS_DLT=analysis-jobs.DLT
KAFKA_CONSUMER_GROUP=gitpulse-analysis-group
KAFKA_CONSUMER_CONCURRENCY=1

# GitHub REST API Configuration (Optional: provides higher rate limits for public/private repos)
# Safe default is empty (unauthenticated requests with 60 req/hr GitHub rate limit)
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_CONNECT_TIMEOUT=5s
GITHUB_READ_TIMEOUT=10s
GITHUB_COMMIT_PAGE_SIZE=30

# Frontend Configuration (Vite development server & API Client)
VITE_API_PROXY_TARGET=http://localhost:8080
VITE_API_BASE_URL=/api/v1
